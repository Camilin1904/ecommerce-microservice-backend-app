pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build with Java 11') {
            steps {
                script {
                    sh '''
                        sudo apt-get install -y openjdk-11-jdk maven
                        export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
                        chmod +x ./mvnw
                        
                        ./mvnw clean package -DskipTests
                            
                    '''
                }
            }
        }
    }
}
