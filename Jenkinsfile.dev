pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build with Java 11') {
            steps {
                script {
                    sh '''
                        chmod +x ./mvnw
                        
                        ./mvnw clean package -DskipTests
                            
                    '''
                }
            }
        }
    }
}
