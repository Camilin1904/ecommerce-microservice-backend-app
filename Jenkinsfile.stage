pipeline {
    agent any
    
    environment {
        PROJECT_VERSION = '0.1.0'
        NAMESPACE = 'default'
        API_GATEWAY_PORT = '8080'
        DOCKER_REGISTRY = 'your-docker-registry'
        KUBECONFIG = '/home/jenkins/.kube/config'
    }
    
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Code checked out successfully'
            }
        }
        
        stage('Install Dependencies') {
            parallel {
                stage('Install Kubectl') {
                    steps {
                        script {
                            sh '''
                                # Check if kubectl is already installed
                                if ! command -v kubectl &> /dev/null; then
                                    echo "Installing kubectl..."
                                    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                                    chmod +x kubectl
                                    sudo mv kubectl /usr/local/bin/
                                else
                                    echo "kubectl is already installed"
                                fi
                                kubectl version --client
                            '''
                        }
                    }
                }
                
                stage('Install Python Dependencies') {
                    steps {
                        script {
                            sh '''
                                # Install Python and pip if not available
                                if ! command -v python3 &> /dev/null; then
                                    sudo apt-get update
                                    sudo apt-get install -y python3 python3-pip
                                fi
                                
                                # Install locust
                                pip3 install locust --user
                            '''
                        }
                    }
                }
                
                stage('Install Node.js Dependencies for E2E') {
                    steps {
                        dir('e2e') {
                            sh '''
                                npm install
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Maven Tests') {
            steps {
                script {
                    echo 'Running Maven tests using root mvnw script...'
                    
                    // Make mvnw executable
                    sh 'chmod +x ./mvnw'
                    
                    // Run tests using root mvnw
                    sh './mvnw clean test'
                    
                    echo 'All Maven tests completed successfully!'
                }
            }
            post {
                always {
                    // Collect test results
                    publishTestResults testResultsPattern: '**/target/surefire-reports/TEST-*.xml'
                    
                    // Archive test reports
                    archiveArtifacts artifacts: '**/target/surefire-reports/**', allowEmptyArchive: true
                }
            }
        }
        
        stage('Build Services') {
            steps {
                script {
                    echo 'Building all services using root mvnw script...'
                    
                    // Make mvnw executable
                    sh 'chmod +x ./mvnw'
                    
                    // Build all services
                    sh './mvnw clean package -DskipTests'
                    
                    echo 'All services built successfully!'
                }
            }
        }
        
        stage('Verify Minikube') {
            steps {
                script {
                    echo 'Verifying minikube status...'
                    sh '''
                        # Check if minikube is running
                        minikube status || {
                            echo "Minikube is not running, starting it..."
                            minikube start --driver=docker
                        }
                        
                        # Set kubectl context to minikube
                        kubectl config use-context minikube
                        
                        # Verify connection
                        kubectl cluster-info
                        kubectl get nodes
                    '''
                }
            }
        }
        
        stage('Build and Load Docker Images to Minikube') {
            steps {
                script {
                    echo 'Building Docker images and loading them to minikube...'
                    sh '''
                        # Point Docker client to minikube's Docker daemon
                        eval $(minikube docker-env)
                        
                        # Build all service images
                        docker-compose -f compose.yml build
                        
                        # Verify images are available in minikube
                        docker images | grep ecommerce
                    '''
                }
            }
        }
        
        stage('Deploy Services to Minikube') {
            steps {
                script {
                    echo 'Deploying services to minikube using deployment script...'
                    dir('k8s') {
                        sh '''
                            # Make the script executable
                            chmod +x deploy-services.sh
                            
                            # Run the deployment script
                            ./deploy-services.sh
                            
                            # Wait for all pods to be ready
                            echo "Waiting for all pods to be ready..."
                            kubectl wait --for=condition=ready pod --all --timeout=600s -n ${NAMESPACE}
                            
                            # Show deployment status
                            kubectl get pods -n ${NAMESPACE}
                            kubectl get services -n ${NAMESPACE}
                        '''
                    }
                }
            }
        }
        
        stage('Expose API Gateway') {
            steps {
                script {
                    echo "Exposing API Gateway on port ${API_GATEWAY_PORT}..."
                    sh '''
                        # Create a service to expose the API Gateway
                        kubectl expose deployment api-gateway --type=NodePort --port=8080 --target-port=8080 -n ${NAMESPACE} --name=api-gateway-external || echo "Service already exists"
                        
                        # Get the NodePort assigned
                        NODE_PORT=$(kubectl get svc api-gateway-external -n ${NAMESPACE} -o jsonpath='{.spec.ports[0].nodePort}')
                        MINIKUBE_IP=$(minikube ip)
                        
                        echo "API Gateway exposed at: http://${MINIKUBE_IP}:${NODE_PORT}"
                        echo "You can also access it via port-forward: kubectl port-forward svc/api-gateway-external 8080:8080 -n ${NAMESPACE}"
                        
                        # Start port-forward in background for tests
                        kubectl port-forward svc/api-gateway-external 8080:8080 -n ${NAMESPACE} > /dev/null 2>&1 &
                        PORTFORWARD_PID=$!
                        echo $PORTFORWARD_PID > /tmp/portforward.pid
                        
                        # Wait for port-forward to be ready
                        sleep 10
                    '''
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    echo 'Performing health checks on deployed services...'
                    timeout(time: 5, unit: 'MINUTES') {
                        sh '''
                            # Wait for API Gateway to be accessible
                            echo "Waiting for API Gateway to be ready..."
                            until curl -f http://localhost:8080/actuator/health > /dev/null 2>&1; do
                                echo "Waiting for API Gateway..."
                                sleep 10
                            done
                            
                            echo "API Gateway is ready!"
                            
                            # Check other service health endpoints through API Gateway
                            echo "Checking service health endpoints..."
                            curl -s http://localhost:8080/actuator/health | jq '.' || echo "API Gateway health check completed"
                        '''
                    }
                }
            }
        }
        
        stage('Run E2E Tests') {
            steps {
                script {
                    echo 'Running E2E tests with Newman...'
                    dir('e2e') {
                        sh '''
                            # Set the base URL for tests
                            export API_BASE_URL="http://localhost:8080"
                            
                            # Run Newman tests with HTML report
                            npm run test:html-report || {
                                echo "E2E tests failed, but continuing with pipeline..."
                                exit 0
                            }
                        '''
                    }
                }
            }
            post {
                always {
                    // Archive E2E test reports
                    archiveArtifacts artifacts: 'e2e/reports/**', allowEmptyArchive: true
                    
                    // Publish HTML reports if available
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'e2e/reports',
                        reportFiles: '*.html',
                        reportName: 'E2E Test Report'
                    ])
                }
            }
        }
        
        stage('Run Locust Performance Tests') {
            steps {
                script {
                    echo 'Running Locust performance tests...'
                    dir('locust') {
                        sh '''
                            # Run Locust tests in headless mode
                            # Adjust users, spawn-rate, and run-time as needed
                            locust -f locustfile.py --headless --users 10 --spawn-rate 2 --run-time 2m --host http://localhost:8080 --html /tmp/locust_report.html || {
                                echo "Locust tests completed (may have warnings)"
                                exit 0
                            }
                            
                            # Copy report to workspace
                            cp /tmp/locust_report.html ./locust_report.html || echo "No Locust report generated"
                        '''
                    }
                }
            }
            post {
                always {
                    // Archive Locust reports
                    archiveArtifacts artifacts: 'locust/locust_report.html', allowEmptyArchive: true
                    
                    // Publish Locust HTML report
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'locust',
                        reportFiles: 'locust_report.html',
                        reportName: 'Locust Performance Test Report'
                    ])
                }
            }
        }
        
        stage('Collect Logs and Metrics') {
            steps {
                script {
                    echo 'Collecting deployment logs and metrics...'
                    sh '''
                        # Collect pod logs
                        mkdir -p logs
                        
                        # Get logs for all pods
                        for pod in $(kubectl get pods -n ${NAMESPACE} -o jsonpath='{.items[*].metadata.name}'); do
                            echo "Collecting logs for pod: $pod"
                            kubectl logs $pod -n ${NAMESPACE} > logs/${pod}.log 2>&1 || echo "Could not get logs for $pod"
                        done
                        
                        # Get deployment status
                        kubectl get all -n ${NAMESPACE} > logs/deployment-status.txt
                        
                        # Get events
                        kubectl get events -n ${NAMESPACE} --sort-by='.lastTimestamp' > logs/events.txt
                    '''
                }
            }
            post {
                always {
                    // Archive logs
                    archiveArtifacts artifacts: 'logs/**', allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Clean up port-forward process
                sh '''
                    if [ -f /tmp/portforward.pid ]; then
                        PID=$(cat /tmp/portforward.pid)
                        kill $PID > /dev/null 2>&1 || echo "Port-forward process already terminated"
                        rm -f /tmp/portforward.pid
                    fi
                '''
            }
        }
        
        success {
            echo '''
            ================================
            🎉 PIPELINE COMPLETED SUCCESSFULLY! 🎉
            ================================
            
            ✅ Maven tests passed
            ✅ Services deployed to minikube
            ✅ API Gateway exposed on port 8080
            ✅ E2E tests completed
            ✅ Performance tests completed
            
            You can access your services:
            - API Gateway: kubectl port-forward svc/api-gateway-external 8080:8080
            - View all services: kubectl get svc
            - View all pods: kubectl get pods
            '''
            
            // Send notifications (configure as needed)
            // emailext to: 'team@example.com', subject: 'Pipeline Success', body: 'All tests passed!'
        }
        
        failure {
            echo '''
            ================================
            ❌ PIPELINE FAILED ❌
            ================================
            
            Please check the logs for more details.
            '''
            
            script {
                // Cleanup on failure (optional)
                sh '''
                    echo "Cleaning up failed deployment..."
                    kubectl delete all --all -n ${NAMESPACE} || echo "Cleanup completed"
                '''
            }
            
            // Send failure notifications
            // emailext to: 'team@example.com', subject: 'Pipeline Failed', body: 'Check Jenkins for details'
        }
        
        cleanup {
            // Clean workspace
            cleanWs()
        }
    }
}