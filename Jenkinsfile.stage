pipeline {
    agent any // Default agent. Assumes basic tools like git.
              // If Jenkins runs on Kubernetes, this might be a specific pod template.
/*
    environment {
        // Define any global environment variables if needed.
        // Example: MINIKUBE_IP = sh(script: 'minikube ip', returnStdout: true).trim()
    }
*/

    
    stages {
        stage('Checkout Source Code') {
            steps {
                script {
                    // Assuming Git SCM is configured in the Jenkins job.
                    // Otherwise, use: git url: 'your-git-repo-url', branch: 'your-branch'
                    checkout scm
                    sh 'echo "Current directory:" && pwd && ls -la'

                    sh 'export PATH=$HOME/bin:$PATH'
                }
            }
        }

        stage('Build and Unit Test Java Services') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-17' // Specify your desired Maven and JDK version
                    args '-v $HOME/.m2:/root/.m2'         // Cache Maven artifacts
                }
            }
            steps {
                script {
                    sh 'chmod +x mvnw'
                    // Assumes 'install' goal runs unit tests.
                    // Use -DskipITs if integration tests are run separately (e.g., by E2E tests).
                    sh './mvnw clean package'
                }
            }
        }

        stage('Deploy Services to Minikube') {
            // This agent needs kubectl and access to your Minikube cluster.
            // If 'agent any' doesn't have it, configure a specific agent (e.g., a K8s pod with kubectl).
            agent any
            steps {
                script {
                    sh 'chmod +x k8s/deploy-services.sh'
                    // Ensure your deploy script (k8s/deploy-services.sh) is configured
                    // to target your Minikube instance.
                    // It might require MINIKUBE_PROFILE or KUBECONFIG to be set.
                    sh 'k8s/deploy-services.sh'
                }
            }
        }

        stage('Run End-to-End (E2E) Tests') {
            agent {
                docker {
                    image 'node:18' // Specify your desired Node.js version
                    // args '-v $HOME/.npm:/root/.npm' // Optional: Cache npm packages
                }
            }
            steps {
                dir('e2e') { // Change to the e2e directory
                    script {
                        sh 'npm install'
                        // Assumes 'npm test' in e2e/package.json runs your Newman tests.
                        // Example: "test": "newman run collections/mycollection.postman_collection.json -e environments/myenvironment.postman_environment.json"
                        // Or if using newman-runner.js: "test": "node newman-runner.js"
                        sh 'npm test'
                    }
                }
            }
        }

        stage('Run Locust Performance Tests') {
            agent {
                docker {
                    image 'locustio/locust'
                }
            }
            steps {
                dir('locust') { // Change to the locust directory
                    script {
                        // Adjust the Locust command as needed.
                        // The --host should point to your application's entry point in Minikube.
                        // This might be an IP and NodePort, e.g., http://$(minikube ip):<service-nodeport>
                        // You may need to retrieve this dynamically or have a fixed setup.
                        sh 'locust -f locustfile.py --headless -u 10 -r 2 --run-time 1m --host=http://api-gateway-service:8080'
                        // Replace 'http://api-gateway-service.default.svc.cluster.local:8080' with your actual application host within the cluster if locust runs in-cluster,
                        // or an externally accessible Minikube service URL if locust runs outside the Minikube network directly.
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
            // JUnit publisher to archive test results (if surefire/failsafe reports are generated)
            // junit '**/target/surefire-reports/*.xml'
            // Clean up workspace
            // cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
            // Add success notifications if needed
        }
        failure {
            echo 'Pipeline failed.'
            // Add failure notifications if needed (e.g., email, Slack)
        }
    }
}
